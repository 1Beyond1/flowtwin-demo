AMAP_JS_KEY=replace_with_your_web_js_key
AMAP_SECURITY_JS_CODE=replace_with_your_security_code
AMAP_WEB_SERVICE_KEY=replace_with_your_web_service_key

# OpenAI-compatible chat endpoint: POST {AI_BASE_URL}/chat/completions
AI_BASE_URL=https://your-ai-gateway.example.com/v1
AI_API_KEY=replace_with_your_ai_api_key
AI_MODEL=replace_with_your_chat_model_name

# Optional speech-to-text: POST {STT_BASE_URL}/audio/transcriptions
# Aliases: SILICONFLOW_API_KEY / SILICONFLOW_BASE_URL / SILICONFLOW_STT_MODEL
STT_API_KEY=replace_with_your_stt_api_key
STT_BASE_URL=https://your-stt-gateway.example.com/v1
STT_MODEL=replace_with_your_speech_to_text_model

FEISHU_WEBHOOK_URL=replace_with_optional_feishu_robot_webhook
PORT=4182
