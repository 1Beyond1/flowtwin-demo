AMAP_JS_KEY=replace_with_your_web_js_key
AMAP_SECURITY_JS_CODE=replace_with_your_security_code
AMAP_WEB_SERVICE_KEY_PRIMARY=replace_with_your_primary_web_service_key
AMAP_WEB_SERVICE_KEY_BACKUP=replace_with_your_backup_web_service_key

# OpenAI-compatible chat endpoint: POST {AI_BASE_URL}/chat/completions
AI_BASE_URL=https://your-ai-gateway.example.com/v1
AI_API_KEY=replace_with_your_ai_api_key
AI_MODEL=replace_with_your_chat_model_name
# Optional fallback; tried only when the primary provider fails.
AI_BACKUP_BASE_URL=https://your-backup-ai-gateway.example.com/v1
AI_BACKUP_API_KEY=replace_with_your_backup_ai_api_key
AI_BACKUP_MODEL=replace_with_your_backup_chat_model_name

# Optional speech-to-text: POST {STT_BASE_URL}/audio/transcriptions
# Aliases: SILICONFLOW_API_KEY / SILICONFLOW_BASE_URL / SILICONFLOW_STT_MODEL
STT_API_KEY=replace_with_your_stt_api_key
STT_BASE_URL=https://your-stt-gateway.example.com/v1
STT_MODEL=replace_with_your_speech_to_text_model

# Optional local CV adapter; blank uses the labelled synthetic demo.
CV_SERVICE_URL=

FEISHU_WEBHOOK_URL=replace_with_optional_feishu_robot_webhook

# Optional Feishu Bitable + AI field integration. Never put these in the frontend.
FEISHU_BASE_URL=https://open.feishu.cn
FEISHU_APP_ID=replace_with_feishu_app_id
FEISHU_APP_SECRET=replace_with_feishu_app_secret
FEISHU_BITABLE_APP_TOKEN=replace_with_feishu_bitable_app_token
FEISHU_SNAPSHOT_TABLE_ID=replace_with_snapshot_table_id
FEISHU_STRATEGY_TABLE_ID=replace_with_strategy_table_id
FEISHU_SYNC_TABLE_ID=replace_with_optional_sync_table_id
FEISHU_AI_STRATEGY_FIELD=AI策略
FEISHU_APPROVAL_FIELD=审批状态

PORT=4182
