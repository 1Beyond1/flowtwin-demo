# Server bind settings
HOST=127.0.0.1
PORT=4182

# Optional AMap keys (leave blank for offline zero-key planning mode)
AMAP_JS_KEY=
AMAP_SECURITY_JS_CODE=
AMAP_WEB_SERVICE_KEY_PRIMARY=
AMAP_WEB_SERVICE_KEY_BACKUP=

# Optional default origin override (defaults to 北京国贸 CBD [116.461, 39.909])
FLOWTWIN_DEFAULT_ORIGIN_NAME=
FLOWTWIN_DEFAULT_ORIGIN_LNG=
FLOWTWIN_DEFAULT_ORIGIN_LAT=

# Optional OpenAI-compatible chat endpoint: POST {AI_BASE_URL}/chat/completions
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
# Optional fallback provider; tried only when the primary provider fails.
AI_BACKUP_BASE_URL=
AI_BACKUP_API_KEY=
AI_BACKUP_MODEL=

# Optional speech-to-text: POST {STT_BASE_URL}/audio/transcriptions
# Aliases: SILICONFLOW_API_KEY / SILICONFLOW_BASE_URL / SILICONFLOW_STT_MODEL
STT_API_KEY=
STT_BASE_URL=
STT_MODEL=

# Optional local CV adapter (e.g. http://127.0.0.1:5099 or http://cv-service:5099);
# blank uses the labelled safe fallback mode.
CV_SERVICE_URL=

# Optional Feishu webhook execution notification
FEISHU_WEBHOOK_URL=

# Optional Feishu Bitable + AI field integration. Credentials stay server-side.
FEISHU_BASE_URL=https://open.feishu.cn
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_BITABLE_APP_TOKEN=
FEISHU_SNAPSHOT_TABLE_ID=
FEISHU_STRATEGY_TABLE_ID=
FEISHU_SYNC_TABLE_ID=
FEISHU_AI_STRATEGY_FIELD=AI策略
FEISHU_APPROVAL_FIELD=审批状态

# Public demo safety switch: 1 keeps local simulation but disables outbound
# Feishu Bitable/Webhook writes and status reads. Leave 0 for a private demo.
FLOWTWIN_PUBLIC_DEMO=0

# Reverse-proxy IP trust mode for per-IP rate limiting (only honored when the
# direct socket peer is loopback or private/internal network):
# - 0 (default): ignore proxy headers and rate-limit by direct socket IP
# - 1 (or integer hop count N): read the Nth-from-right X-Forwarded-For IP
# - cloudflare: trust CF-Connecting-IP when behind a local/private proxy tunnel
FLOWTWIN_TRUST_PROXY=0

# Optional build/version metadata overrides
FLOWTWIN_REPO=
FLOWTWIN_COMMIT=
FLOWTWIN_BUILD_TIME=

# Per-client-IP rate limits (default window: 10 minutes = 600000 ms)
FLOWTWIN_RATE_LIMIT_WINDOW_MS=600000
FLOWTWIN_RATE_LIMIT_MAX_CLIENTS=10000
FLOWTWIN_RATE_LIMIT_PLAN=30
FLOWTWIN_RATE_LIMIT_STT=10
FLOWTWIN_RATE_LIMIT_MAP=180
FLOWTWIN_RATE_LIMIT_CV=6
FLOWTWIN_RATE_LIMIT_OPERATOR=12
FLOWTWIN_RATE_LIMIT_VALIDATE=4
FLOWTWIN_RATE_LIMIT_FEISHU_SYNC=10
FLOWTWIN_RATE_LIMIT_FEISHU_STATUS=60
FLOWTWIN_RATE_LIMIT_APPROVE=20
FLOWTWIN_RATE_LIMIT_VERSION_CHECK=12
FLOWTWIN_RATE_LIMIT_EXECUTION=6
